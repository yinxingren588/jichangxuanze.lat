---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AIRPORTS_DATA } from '../../data/airports';
---

<BaseLayout
  title="机场评测中心 - 深度实测报告与测速数据 | 机场选择"
  description="客观详实的机场评测归档。包含晚高峰测速图谱、流媒体与ChatGPT解锁检测、丢包率统计及性价比综合分析。"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="max-w-3xl mb-12">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-cyan-950/80 border border-cyan-800/60 text-xs text-cyan-300 font-medium mb-3">
        <span>📝 深度实测实验室</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        机场深度评测中心
      </h1>
      <p class="text-slate-400 text-sm mt-3 leading-relaxed">
        每一篇评测均由实机独立采购套餐、持续监控 14 天以上，并在晚间黄金高峰时段进行 Speedtest、YouTube 4K 缓冲及主流流媒体全自动解锁检测。
      </p>
    </div>

    <!-- Review Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {AIRPORTS_DATA.map((airport) => (
        <div class="p-6 rounded-2xl bg-slate-900/90 border border-slate-800 hover:border-cyan-500/50 transition-all flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="text-xs font-semibold px-2.5 py-0.5 rounded bg-cyan-950 text-cyan-400 border border-cyan-800/60">
                {airport.categoryLabel}
              </span>
              <span class="text-xs text-amber-400 font-bold">
                ★ {airport.rating} / 5.0
              </span>
            </div>

            <h2 class="text-xl font-bold text-white group-hover:text-cyan-400 transition-colors">
              <a href={`/reviews/${airport.reviewSlug || airport.slug}`}>
                {airport.name} 深度测评
              </a>
            </h2>

            <p class="text-xs text-slate-400 mt-2 leading-relaxed">
              {airport.slogan}
            </p>

            <div class="mt-4 p-3 rounded-xl bg-slate-950/70 border border-slate-800/60 text-xs space-y-1.5">
              <div class="flex justify-between">
                <span class="text-slate-500">晚高峰实测：</span>
                <span class="text-emerald-400 font-semibold">{airport.speedPeak}</span>
              </div>
              <div class="flex justify-between">
                <span class="text-slate-500">线路类型：</span>
                <span class="text-slate-200">{airport.lineType}</span>
              </div>
              <div class="flex justify-between">
                <span class="text-slate-500">起步价格：</span>
                <span class="text-cyan-400 font-bold">¥{airport.priceStart} /{airport.billingCycle}</span>
              </div>
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-800/60 flex items-center justify-between">
            <a
              href={`/reviews/${airport.reviewSlug || airport.slug}`}
              class="text-xs font-semibold text-cyan-400 hover:text-cyan-300 flex items-center gap-1"
            >
              <span>阅读完整评测报告</span>
              <span>→</span>
            </a>
            <a
              href={airport.affUrl}
              target="_blank"
              rel="noopener noreferrer nofollow"
              class="text-xs px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-cyan-600 hover:text-white text-slate-300 transition-colors"
            >
              官网 ↗
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
