---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AIRPORTS_DATA, type Airport } from '../../data/airports';
import { getAirportBenchmark } from '../../data/benchmarks';

export function getStaticPaths() {
  return AIRPORTS_DATA.map((airport) => ({
    params: { slug: airport.reviewSlug || airport.slug },
    props: { airport },
  }));
}

interface Props {
  airport: Airport;
}

const { airport } = Astro.props;
const benchmark = getAirportBenchmark(airport);

// Google Product & Review Schema for Rich Snippets (Stars in SERP)
const reviewSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: airport.name,
  description: airport.slogan,
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: airport.rating.toString(),
    bestRating: '5',
    ratingCount: airport.reviewCount.toString(),
  },
  offers: {
    '@type': 'Offer',
    priceCurrency: 'CNY',
    price: airport.priceStart.toString(),
    priceValidUntil: '2026-12-31',
    availability: 'https://schema.org/InStock',
  },
  review: {
    '@type': 'Review',
    reviewRating: {
      '@type': 'Rating',
      ratingValue: airport.rating.toString(),
      bestRating: '5',
    },
    author: {
      '@type': 'Organization',
      name: '机场选择实测实验室',
    },
    reviewBody: `${airport.name} 实测报告：晚高峰测速达到 ${airport.speedPeak}，采用 ${airport.lineType}，原生解锁 ${airport.streamingUnlock.join('、')}。`,
  },
});
---

<BaseLayout
  title={`${airport.name} 怎么样？2025深度评测报告与晚高峰测速 | 机场选择`}
  description={`${airport.name} 深度实测报告：线路类型 ${airport.lineType}，晚高峰实测 ${airport.speedPeak}，解锁 ${airport.streamingUnlock.join(', ')}。附独家优惠码与购买建议。`}
  schemaJson={reviewSchema}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6">
      <a href="/" class="hover:text-slate-300">首页</a>
      <span>/</span>
      <a href="/reviews/" class="hover:text-slate-300">评测中心</a>
      <span>/</span>
      <span class="text-cyan-400 font-medium">{airport.name}</span>
    </nav>

    <!-- Header Hero Card -->
    <div class="p-6 sm:p-8 rounded-3xl bg-slate-900 border border-slate-800 shadow-2xl mb-10">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="flex items-start sm:items-center gap-4 sm:gap-5">
          {airport.logo && (
            <img
              src={airport.logo}
              alt={`${airport.name} Logo`}
              class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-white p-1.5 shadow-xl border-2 border-cyan-500/50 object-contain shrink-0"
            />
          )}
          <div>
            <div class="flex items-center gap-2 mb-2">
              <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-cyan-950 text-cyan-400 border border-cyan-800">
                {airport.categoryLabel}
              </span>
              <span class="text-xs font-medium px-2.5 py-0.5 rounded-full bg-amber-500/10 text-amber-300 border border-amber-500/20">
                综合评分：★ {airport.rating} / 5.0
              </span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
              {airport.name} 深度测评与使用报告
            </h1>
            <p class="text-sm text-slate-400 mt-2 max-w-2xl leading-relaxed">
              {airport.slogan}
            </p>
          </div>
        </div>

        <!-- Pricing CTA Box -->
        <div class="shrink-0 p-5 rounded-2xl bg-slate-950 border border-slate-800 text-center md:text-right flex flex-col justify-between">
          <div>
            <span class="text-xs text-slate-400">起步特惠</span>
            <div class="text-3xl font-extrabold text-cyan-400">
              ¥{airport.priceStart} <span class="text-xs text-slate-400 font-normal">/{airport.billingCycle}</span>
            </div>
            {airport.slug === 'invisible' && (
              <span class="text-[11px] text-emerald-400 block mt-0.5 font-medium">年付折合约 ¥8/月</span>
            )}
          </div>
          <div class="mt-4 flex flex-col gap-2">
            <a
              href={airport.affUrl}
              target="_blank"
              rel="noopener noreferrer nofollow"
              class="px-6 py-2.5 rounded-xl font-semibold text-xs bg-gradient-to-r from-cyan-500 to-blue-600 text-white hover:from-cyan-400 hover:to-blue-500 shadow-md shadow-cyan-500/20 transition-all text-center flex items-center justify-center gap-1"
            >
              <span>直达官网开通</span>
              <span>↗</span>
            </a>
            {airport.coupon && (
              <button
                type="button"
                data-copy-code={airport.coupon.code}
                class="px-4 py-1.5 rounded-lg text-xs bg-slate-800 hover:bg-slate-700 text-cyan-300 font-mono transition-colors text-center cursor-pointer"
              >
                优惠码: {airport.coupon.code}
              </button>
            )}
          </div>
        </div>
      </div>
    </div>

    <!-- Rating Breakdown Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-10">
      <div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800 text-center">
        <div class="text-xs text-slate-400">晚高峰速度</div>
        <div class="text-xl font-bold text-emerald-400 mt-1">{airport.speedPeak}</div>
        <div class="text-[11px] text-slate-500 mt-0.5">4K/8K 秒开</div>
      </div>
      <div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800 text-center">
        <div class="text-xs text-slate-400">线路类型</div>
        <div class="text-sm font-bold text-white mt-2 truncate">{airport.lineType}</div>
        <div class="text-[11px] text-slate-500 mt-0.5">不过 GFW 审查</div>
      </div>
      <div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800 text-center">
        <div class="text-xs text-slate-400">流媒体 / AI</div>
        <div class="text-sm font-bold text-cyan-400 mt-2">全系原生解锁</div>
        <div class="text-[11px] text-slate-500 mt-0.5">ChatGPT/Claude/NF</div>
      </div>
      <div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800 text-center">
        <div class="text-xs text-slate-400">协议支持</div>
        <div class="text-sm font-bold text-white mt-2 truncate">{airport.protocols.join(', ')}</div>
        <div class="text-[11px] text-slate-500 mt-0.5">全平台客户端</div>
      </div>
    </div>

    <!-- Main Content Details -->
    <div class="space-y-10">
      
      <!-- Section 1: 测速与晚高峰表现 -->
      <section class="p-6 sm:p-8 rounded-2xl bg-slate-900/40 border border-slate-800">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
          <h2 class="text-xl font-bold text-white flex items-center gap-2">
            <span>⚡ 晚高峰多轮测速与网络质量实测报告</span>
          </h2>
          <span class="inline-flex items-center gap-1.5 text-xs text-emerald-400 bg-emerald-950/80 border border-emerald-800/60 px-2.5 py-1 rounded-full w-fit">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
            <span>晚高峰连续 10 轮压力实测</span>
          </span>
        </div>

        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-5">
          我们使用千兆电信独立宽带，在晚高峰（20:45 ~ 22:30）全网拥堵黄金时段对 <strong class="text-white">{airport.name}</strong> 的主流出入口节点进行了多轮深度压测。测试覆盖香港、日本、新加坡、台湾及美国等核心主力出口：
        </p>

        <!-- Testing Rig Specs Infobar -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 p-3.5 rounded-xl bg-slate-950 border border-slate-800/80 mb-5 text-[11px] text-slate-400">
          <div>
            <span class="text-slate-500 block mb-0.5">🌐 本地测试宽带</span>
            <span class="text-slate-200 font-medium">{benchmark.testEnvironment.isp}</span>
          </div>
          <div>
            <span class="text-slate-500 block mb-0.5">💻 终端与接入</span>
            <span class="text-slate-200 font-medium">{benchmark.testEnvironment.terminal}</span>
          </div>
          <div>
            <span class="text-slate-500 block mb-0.5">⚙️ 客户端与内核</span>
            <span class="text-slate-200 font-medium">{benchmark.testEnvironment.core}</span>
          </div>
          <div>
            <span class="text-slate-500 block mb-0.5">⏱️ 采样时段与算法</span>
            <span class="text-slate-200 font-medium">{benchmark.testEnvironment.time}</span>
          </div>
        </div>

        <!-- Realistic Benchmarks Table -->
        <div class="overflow-x-auto rounded-xl border border-slate-800 bg-slate-950 shadow-inner">
          <table class="w-full text-left text-xs">
            <thead>
              <tr class="border-b border-slate-800 bg-slate-900/90 text-slate-400 font-semibold">
                <th class="p-3.5 whitespace-nowrap">测试节点与线路</th>
                <th class="p-3.5 whitespace-nowrap">下行速率均值 (峰值)</th>
                <th class="p-3.5 whitespace-nowrap">上行速率</th>
                <th class="p-3.5 whitespace-nowrap">延迟 (Ping / 抖动)</th>
                <th class="p-3.5 whitespace-nowrap">丢包率 (Packet Loss)</th>
                <th class="p-3.5 whitespace-nowrap">YouTube 4K 缓冲实测</th>
                <th class="p-3.5 whitespace-nowrap text-center">状态</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800/60 text-slate-300">
              {benchmark.nodes.map((node) => (
                <tr class="hover:bg-slate-900/50 transition-colors">
                  <td class="p-3.5">
                    <div class="flex items-center gap-2">
                      <span class="text-base">{node.flag}</span>
                      <div>
                        <div class="font-medium text-white flex items-center gap-1.5">
                          <span>{node.name}</span>
                          <span class="text-[10px] px-1.5 py-0.2 rounded bg-slate-800 text-slate-300 font-mono">
                            {node.protocol}
                          </span>
                        </div>
                        <span class="text-[11px] text-slate-400 block mt-0.5">
                          {node.type}
                        </span>
                      </div>
                    </div>
                  </td>
                  <td class="p-3.5 whitespace-nowrap">
                    <span class="text-emerald-400 font-bold text-sm font-mono">
                      {node.downAvg} <span class="text-xs font-normal">Mbps</span>
                    </span>
                    <span class="block text-[11px] text-slate-500 font-mono">
                      峰值 {node.downPeak} Mbps
                    </span>
                  </td>
                  <td class="p-3.5 whitespace-nowrap font-mono text-slate-200">
                    {node.upAvg} Mbps
                  </td>
                  <td class="p-3.5 whitespace-nowrap">
                    <span class="font-semibold text-white font-mono">{node.ping} ms</span>
                    <span class="block text-[11px] text-slate-500 font-mono">±{node.jitter} ms</span>
                  </td>
                  <td class="p-3.5 whitespace-nowrap">
                    <span class={`font-mono font-medium ${node.loss === '0.0%' ? 'text-emerald-400' : 'text-amber-400'}`}>
                      {node.loss}
                    </span>
                    <span class="block text-[10px] text-slate-500">
                      {node.lossDetail}
                    </span>
                  </td>
                  <td class="p-3.5 whitespace-nowrap">
                    <span class="text-cyan-400 font-mono font-semibold">
                      {node.ytSpeed}
                    </span>
                    <span class="block text-[11px] text-slate-400">
                      起播 {node.ytStartup} · 缓冲 {node.ytBufferHealth}
                    </span>
                  </td>
                  <td class="p-3.5 whitespace-nowrap text-center">
                    <span class={`text-[11px] font-semibold px-2 py-0.5 rounded-full border ${node.ratingColor}`}>
                      ● {node.rating}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- Real YouTube Stats for Nerds Panel -->
        <div class="mt-5 p-4 rounded-xl bg-slate-950 border border-slate-800 text-xs">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 mb-3 border-b border-slate-800/80">
            <div class="flex items-center gap-2 text-slate-200 font-semibold">
              <span class="w-2.5 h-2.5 rounded-full bg-rose-500 animate-pulse"></span>
              <span>YouTube 4K@60fps 原生视频「详细统计信息 (Stats for nerds)」真实抓包</span>
            </div>
            <span class="text-[11px] font-mono text-cyan-300 bg-cyan-950/80 border border-cyan-800/60 px-2.5 py-0.5 rounded-md w-fit">
              采样节点：{benchmark.nerdStats.nodeName}
            </span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 text-slate-400 text-[11px] font-mono">
            <div>
              <span class="text-slate-500 block mb-0.5">Video ID / Codecs</span>
              <span class="text-slate-200">{benchmark.nerdStats.videoId}</span>
            </div>
            <div>
              <span class="text-slate-500 block mb-0.5">Connection Speed (连接速度)</span>
              <span class="text-emerald-400 font-bold text-xs">{benchmark.nerdStats.connectionSpeed}</span>
            </div>
            <div>
              <span class="text-slate-500 block mb-0.5">Buffer Health (缓冲区深度)</span>
              <span class="text-cyan-300 font-semibold">{benchmark.nerdStats.bufferHealth}</span>
            </div>
            <div>
              <span class="text-slate-500 block mb-0.5">Dropped Frames (丢帧监测)</span>
              <span class="text-emerald-400 font-semibold">{benchmark.nerdStats.droppedFrames}</span>
            </div>
          </div>
        </div>

        <!-- Methodology Note -->
        <div class="mt-4 p-3 rounded-lg bg-slate-950/50 border border-slate-800/60 text-[11px] text-slate-400 leading-relaxed flex items-start gap-2">
          <span class="text-cyan-400 shrink-0">💡</span>
          <span>
            <strong>实测说明与方法论：</strong>
            晚高峰（20:45 ~ 22:30）全网国际骨干出口处于负载峰值期。以上数据基于我们自费购买的独立账号，使用 Speedtest CLI 多线程并发测速与 YouTube 4K 60fps 连续压测取中位数。不同省份、运营商（电信/联通/移动）因本地骨干互联可能存在微量偏差，但数据足以客观体现节点线路真实承载力。
          </span>
        </div>
      </section>

      <!-- Section 2: 官方套餐矩阵与资费明细 -->
      {airport.plans && airport.plans.length > 0 && (
        <section class="p-6 sm:p-8 rounded-2xl bg-slate-900/40 border border-slate-800" id="plans-section">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6">
            <div>
              <div class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full bg-cyan-950 text-cyan-300 text-xs font-semibold mb-2">
                <span>💳 官方资费标准</span>
              </div>
              <h2 class="text-xl sm:text-2xl font-bold text-white flex items-center gap-2">
                <span>{airport.name} 官方 9 大主力套餐与资费明细</span>
              </h2>
            </div>
            {airport.coupon && (
              <div class="flex items-center gap-2 text-xs bg-cyan-950/80 border border-cyan-800/60 px-3 py-1.5 rounded-xl text-cyan-300 shrink-0">
                <span>专属折扣码：</span>
                <strong class="text-white font-mono text-sm">{airport.coupon.code}</strong>
                <button
                  type="button"
                  data-copy-code={airport.coupon.code}
                  class="ml-1 text-[11px] px-2 py-0.5 rounded bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold transition-colors cursor-pointer"
                >
                  一键复制
                </button>
              </div>
            )}
          </div>

          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-6">
            以下为 {airport.name} 官方当前在售的完整 <strong>9 个配套规格</strong>，包含 <strong>5 款周期循环订阅（月付/年付）</strong>、<strong>3 款永不过期一次性买断包</strong> 以及 <strong>1 款企业顶配王者定制版</strong>。所有套餐均采用<strong>全链路 {airport.slug === 'invisible' ? 'IEPL' : 'IPLC'} 纯专线</strong>架构与 <strong>1x 统一计费倍率</strong>：
          </p>

          <!-- Plan Category Tabs Filter -->
          <div class="flex items-center gap-2 flex-wrap mb-6" id="plan-filter-tabs">
            <button
              type="button"
              data-plan-filter="all"
              class="plan-tab-active px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-cyan-500 text-slate-950 shadow-md shadow-cyan-500/20 transition-all cursor-pointer"
            >
              全部配套 (9)
            </button>
            <button
              type="button"
              data-plan-filter="subscription"
              class="px-3.5 py-1.5 rounded-xl text-xs font-medium bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-800 transition-all cursor-pointer"
            >
              🔄 周期循环订阅 (5)
            </button>
            <button
              type="button"
              data-plan-filter="onetime"
              class="px-3.5 py-1.5 rounded-xl text-xs font-medium bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-800 transition-all cursor-pointer"
            >
              ⏳ 永不过期一次性买断 (3)
            </button>
            <button
              type="button"
              data-plan-filter="custom"
              class="px-3.5 py-1.5 rounded-xl text-xs font-medium bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-800 transition-all cursor-pointer"
            >
              🏢 商业企业定制 (1)
            </button>
          </div>

          <!-- 3x3 Grid (三排三个) -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="plans-container">
            {airport.plans.map((plan) => (
              <div
                class={`plan-item group rounded-2xl border transition-all duration-300 p-5 sm:p-6 flex flex-col justify-between ${
                  plan.isPopular
                    ? 'bg-gradient-to-br from-slate-900 via-slate-900 to-cyan-950/40 border-2 border-cyan-500/80 shadow-xl shadow-cyan-950/50 hover:border-cyan-400'
                    : 'bg-slate-950/80 border-slate-800 hover:border-slate-700 hover:bg-slate-900/90'
                }`}
                data-category={plan.planCategory || 'subscription'}
              >
                <div>
                  <!-- Card Header: Badge & Cycles -->
                  <div class="flex items-center justify-between gap-2 mb-3">
                    <span class={`text-[11px] font-bold px-2.5 py-0.5 rounded-full ${
                      plan.isPopular
                        ? 'bg-cyan-500 text-slate-950 shadow-md shadow-cyan-500/30'
                        : plan.planCategory === 'onetime'
                        ? 'bg-amber-500/20 text-amber-300 border border-amber-500/30'
                        : plan.planCategory === 'custom'
                        ? 'bg-purple-500/20 text-purple-300 border border-purple-500/30'
                        : 'bg-slate-800 text-cyan-300 border border-slate-700'
                    }`}>
                      {plan.badge || '推荐选择'}
                    </span>
                    <span class="text-[10px] px-2 py-0.5 rounded bg-slate-900 text-slate-400 border border-slate-800 font-mono">
                      {plan.billingCycles.join('/')}
                    </span>
                  </div>

                  <!-- Title & Desc -->
                  <h3 class="text-base sm:text-lg font-extrabold text-white group-hover:text-cyan-400 transition-colors">
                    {plan.name}
                  </h3>
                  <p class="text-xs text-slate-400 mt-1 leading-relaxed line-clamp-2 min-h-[32px]">
                    {plan.desc}
                  </p>

                  <!-- Price Box -->
                  <div class="mt-4 p-3.5 rounded-xl bg-slate-900/90 border border-slate-800">
                    <span class="text-[10px] text-slate-500 uppercase font-mono tracking-wider block">CURRENT OFFER 当前特惠</span>
                    <div class="flex items-baseline gap-1 mt-0.5">
                      <span class="text-2xl sm:text-3xl font-extrabold text-cyan-400 font-mono">{plan.price}</span>
                      <span class="text-xs text-slate-400">{plan.period}</span>
                    </div>
                  </div>

                  <!-- 3 Specs Pills -->
                  <div class="grid grid-cols-3 gap-1.5 mt-3 text-center text-xs">
                    <div class="p-2 rounded-lg bg-slate-900/60 border border-slate-800/80">
                      <span class="text-[10px] text-slate-500 block">
                        {plan.planCategory === 'onetime' ? '买断流量' : '月流量'}
                      </span>
                      <span class="font-bold text-white text-xs mt-0.5 block">{plan.traffic}</span>
                    </div>
                    <div class="p-2 rounded-lg bg-slate-900/60 border border-slate-800/80">
                      <span class="text-[10px] text-slate-500 block">速率</span>
                      <span class="font-bold text-emerald-400 text-xs mt-0.5 block truncate">{plan.speed}</span>
                    </div>
                    <div class="p-2 rounded-lg bg-slate-900/60 border border-slate-800/80">
                      <span class="text-[10px] text-slate-500 block">设备数</span>
                      <span class="font-bold text-cyan-400 text-xs mt-0.5 block truncate">{plan.devices}</span>
                    </div>
                  </div>

                  <!-- Features List -->
                  <div class="mt-4 pt-3 border-t border-slate-800/80">
                    <div class="text-[11px] font-semibold text-slate-300 uppercase tracking-wider mb-2 flex items-center gap-1.5">
                      <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
                      <span>核心权益说明</span>
                    </div>
                    <ul class="space-y-1.5 text-xs text-slate-300">
                      {plan.features.slice(0, 4).map((feature) => (
                        <li class="flex items-start gap-1.5 leading-snug">
                          <span class="text-cyan-400 font-bold shrink-0 mt-0.5 text-[10px]">●</span>
                          <span class="line-clamp-2 text-slate-300 text-[11px]">{feature}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>

                <!-- Bottom CTA -->
                <div class="mt-5 pt-3 border-t border-slate-800/60">
                  <a
                    href={airport.affUrl}
                    target="_blank"
                    rel="noopener noreferrer nofollow"
                    class={`w-full py-2.5 px-4 rounded-xl text-center text-xs font-bold transition-all flex items-center justify-center gap-1.5 cursor-pointer ${
                      plan.isPopular
                        ? 'bg-gradient-to-r from-cyan-400 via-teal-400 to-blue-500 text-slate-950 hover:brightness-110 shadow-lg shadow-cyan-500/30'
                        : 'bg-slate-800 hover:bg-slate-700 text-white border border-slate-700'
                    }`}
                  >
                    <span>{plan.planCategory === 'onetime' ? '立即买断此流量包' : '立即订阅此套餐'}</span>
                    <span>→</span>
                  </a>
                  <div class="text-center text-[10px] text-slate-500 mt-2 truncate">
                    {plan.planCategory === 'onetime' ? '一次性买断 · 流量永不过期' : '全节点 1x 计费 · 晚高峰不限速'}
                  </div>
                </div>

              </div>
            ))}
          </div>

          <script>
            const planTabs = document.querySelectorAll('#plan-filter-tabs button');
            const planItems = document.querySelectorAll('.plan-item');

            planTabs.forEach((tab) => {
              tab.addEventListener('click', () => {
                const targetCat = tab.getAttribute('data-plan-filter');

                planTabs.forEach((t) => {
                  t.classList.remove('plan-tab-active', 'bg-cyan-500', 'text-slate-950', 'shadow-md', 'shadow-cyan-500/20');
                  t.classList.add('bg-slate-900', 'text-slate-300', 'border', 'border-slate-800');
                });

                tab.classList.add('plan-tab-active', 'bg-cyan-500', 'text-slate-950', 'shadow-md', 'shadow-cyan-500/20');
                tab.classList.remove('bg-slate-900', 'text-slate-300', 'border', 'border-slate-800');

                planItems.forEach((item) => {
                  const cat = item.getAttribute('data-category');
                  if (targetCat === 'all' || cat === targetCat) {
                    (item as HTMLElement).style.display = '';
                  } else {
                    (item as HTMLElement).style.display = 'none';
                  }
                });
              });
            });
          </script>
        </section>
      )}

      <!-- Section 3: 流媒体与 AI 解锁测试 -->
      <section class="p-6 sm:p-8 rounded-2xl bg-slate-900/40 border border-slate-800">
        <h2 class="text-xl font-bold text-white mb-4 flex items-center gap-2">
          <span>🔓 流媒体与 AI 平台解锁支持</span>
        </h2>
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-4">
          针对 OpenAI / ChatGPT 与各类全球流媒体的封锁机制，{airport.name} 均部署了专门的流媒体出口调度：
        </p>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
          {airport.streamingUnlock.map((item) => (
            <div class="p-3 rounded-xl bg-slate-950 border border-slate-800 flex items-center justify-between text-xs">
              <span class="text-slate-200">{item}</span>
              <span class="text-emerald-400 font-bold">✓ 原生解锁</span>
            </div>
          ))}
          <div class="p-3 rounded-xl bg-slate-950 border border-slate-800 flex items-center justify-between text-xs">
            <span class="text-slate-200">TikTok 运营/直播</span>
            <span class="text-emerald-400 font-bold">✓ 支持</span>
          </div>
        </div>
      </section>

      <!-- Section 3: 优缺点对比 -->
      <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="p-6 rounded-2xl bg-slate-900/60 border border-emerald-950/60">
          <h3 class="text-base font-bold text-emerald-400 mb-4 flex items-center gap-2">
            <span>👍 优点总结</span>
          </h3>
          <ul class="space-y-2 text-xs sm:text-sm text-slate-300">
            {airport.pros.map((pro) => (
              <li class="flex items-start gap-2">
                <span class="text-emerald-400 font-bold shrink-0">✓</span>
                <span>{pro}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="p-6 rounded-2xl bg-slate-900/60 border border-rose-950/60">
          <h3 class="text-base font-bold text-rose-400 mb-4 flex items-center gap-2">
            <span>⚠️ 缺点与注意事项</span>
          </h3>
          <ul class="space-y-2 text-xs sm:text-sm text-slate-300">
            {airport.cons.map((con) => (
              <li class="flex items-start gap-2">
                <span class="text-rose-400 font-bold shrink-0">✕</span>
                <span>{con}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- Section 4: 购买建议与总结 -->
      <section class="p-6 sm:p-8 rounded-2xl bg-gradient-to-br from-slate-900 via-slate-900 to-cyan-950/30 border border-cyan-800/40 text-center">
        <h2 class="text-xl font-bold text-white mb-2">
          🎯 测评总结与选购建议
        </h2>
        <p class="text-xs sm:text-sm text-slate-300 max-w-2xl mx-auto leading-relaxed mb-6">
          总体而言，{airport.name} 适合作为<strong>追求稳定、对晚高峰 4K 播放与 AI 工具使用有刚需的主力机场</strong>。
          建议初次购买时先选择<strong>月付或季付套餐</strong>，体验满意后再升级年付。
        </p>

        <div class="inline-flex flex-wrap items-center justify-center gap-4">
          <a
            href={airport.affUrl}
            target="_blank"
            rel="noopener noreferrer nofollow"
            class="px-8 py-3 rounded-xl font-semibold text-sm bg-gradient-to-r from-cyan-500 to-blue-600 text-white hover:from-cyan-400 hover:to-blue-500 shadow-xl shadow-cyan-500/25 transition-all flex items-center gap-1.5"
          >
            <span>立即直达 {airport.name} 官网</span>
            <span>↗</span>
          </a>
          <a
            href="/reviews/"
            class="px-6 py-3 rounded-xl font-semibold text-sm bg-slate-800 text-slate-300 hover:bg-slate-700 transition-colors"
          >
            返回查看更多评测
          </a>
        </div>
      </section>

    </div>
  </div>
</BaseLayout>
