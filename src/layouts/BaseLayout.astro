---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_METADATA } from '../data/navigation';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  schemaJson?: string;
}

const {
  title = SITE_METADATA.title,
  description = SITE_METADATA.description,
  canonical = Astro.url.href,
  schemaJson,
} = Astro.props;

// Base website structured data
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  'name': SITE_METADATA.shortTitle,
  'url': SITE_METADATA.siteUrl,
  'description': SITE_METADATA.description,
  'inLanguage': 'zh-CN',
};
---

<!doctype html>
<html lang="zh-CN" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>✈️</text></svg>" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="机场选择, 机场推荐, 科学上网, 翻墙机场, IPLC专线, 节点测速, 便宜机场, 稳定机场, Clash教程, Sing-box, 小火箭, FAQ排错" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" title="网站地图" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    {schemaJson && <script type="application/ld+json" set:html={schemaJson} />}

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+SC:wght@400;500;700&display=swap" rel="stylesheet">

    <style is:global>
      body {
        font-family: 'Inter', 'Noto Sans SC', system-ui, -apple-system, sans-serif;
      }
    </style>
  </head>
  <body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col antialiased selection:bg-cyan-500 selection:text-white relative">
    
    <!-- Top Reading Progress Bar -->
    <div id="reading-progress" class="fixed top-0 left-0 h-[3px] bg-gradient-to-r from-cyan-400 via-teal-300 to-blue-500 z-[100] transition-all duration-75 w-0 pointer-events-none"></div>

    <!-- Background subtle gradient glow -->
    <div class="fixed inset-0 pointer-events-none -z-10 overflow-hidden">
      <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[800px] h-[500px] bg-gradient-to-tr from-cyan-600/15 via-blue-600/10 to-indigo-600/10 blur-[130px] rounded-full"></div>
      <div class="absolute top-1/2 -left-40 w-[600px] h-[500px] bg-gradient-to-br from-teal-600/10 via-cyan-600/5 to-transparent blur-[140px] rounded-full"></div>
    </div>

    <!-- Top Announcement Bar -->
    <div class="bg-gradient-to-r from-cyan-950/80 via-slate-900 to-blue-950/80 border-b border-cyan-800/30 text-xs text-slate-300 py-2 px-4 text-center">
      <span class="inline-flex items-center gap-1.5 font-medium">
        <span class="flex h-2 w-2 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-500"></span>
        </span>
        <strong class="text-cyan-300">2025/2026 最新测速更新：</strong> 全站 14 家品牌均完成晚高峰 20:00~23:00 4K 压测与 AI/流媒体双解锁验证。
      </span>
    </div>

    <Header />

    <main class="flex-grow">
      <slot />
    </main>

    <Footer />

    <!-- Global Floating Copy Toast Notification -->
    <div id="toast-container" class="fixed top-8 left-1/2 -translate-x-1/2 z-[110] pointer-events-none transition-all duration-300 opacity-0 -translate-y-4">
      <div class="px-5 py-2.5 rounded-2xl bg-slate-900/95 border border-cyan-500/60 text-white text-xs sm:text-sm font-medium shadow-2xl shadow-cyan-950/90 backdrop-blur-xl flex items-center gap-2.5">
        <span class="text-base text-emerald-400">✓</span>
        <span id="toast-message">已成功复制优惠码到剪贴板！</span>
      </div>
    </div>

    <!-- Floating Back to Top Button -->
    <button
      id="back-to-top"
      type="button"
      class="fixed bottom-6 right-6 z-40 p-3 rounded-2xl bg-slate-900/90 hover:bg-slate-800 text-cyan-400 border border-slate-700/80 shadow-2xl backdrop-blur-md opacity-0 pointer-events-none transition-all duration-300 hover:scale-110 active:scale-95 cursor-pointer"
      aria-label="返回顶部"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18" />
      </svg>
    </button>

    <!-- Sticky Bottom Conversion Bar on Scroll -->
    <div
      id="sticky-conversion-bar"
      class="fixed bottom-0 inset-x-0 z-40 bg-slate-950/95 border-t border-cyan-900/60 backdrop-blur-2xl px-4 py-3 transition-transform duration-300 translate-y-full shadow-2xl"
    >
      <div class="max-w-6xl mx-auto flex items-center justify-between gap-3 text-xs sm:text-sm">
        <div class="flex items-center gap-2 truncate">
          <span class="flex h-2 w-2 relative shrink-0">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-500"></span>
          </span>
          <img
            src="/images/logos/invisible.jpg"
            alt="隐形人 Logo"
            class="w-6 h-6 rounded-md bg-white p-0.5 object-contain shrink-0 border border-cyan-800 hidden sm:inline-block"
          />
          <span class="text-slate-300 truncate">
            晚高峰频繁卡顿断流？推荐使用
            <strong class="text-white">👑 隐形人 (Invisible) IEPL 物理专线</strong>
            <span class="hidden sm:inline text-cyan-400/90 font-mono">（专属码: yxr888）</span>
          </span>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <button
            type="button"
            data-copy-code="yxr888"
            class="hidden sm:inline-block px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-800 hover:bg-slate-700 text-cyan-300 transition-colors cursor-pointer"
          >
            复制 yxr888
          </button>
          <a
            href="https://varnexa.invisibleaff.com/#/?code=JF4seZUy"
            target="_blank"
            rel="noopener noreferrer nofollow"
            class="px-4 py-1.5 rounded-xl text-xs font-bold bg-gradient-to-r from-cyan-500 to-blue-600 text-white hover:from-cyan-400 hover:to-blue-500 shadow-md shadow-cyan-500/20 transition-all flex items-center gap-1"
          >
            <span>直达专线官网</span>
            <span>↗</span>
          </a>
          <button
            type="button"
            id="close-sticky-bar"
            class="p-1.5 rounded-lg text-slate-500 hover:text-slate-300"
            aria-label="关闭提示"
          >
            ✕
          </button>
        </div>
      </div>
    </div>

    <!-- Enhanced Interaction Scripts -->
    <script>
      // 1. Reading Progress Bar
      const progressBar = document.getElementById('reading-progress');
      const backToTopBtn = document.getElementById('back-to-top');
      const stickyBar = document.getElementById('sticky-conversion-bar');
      const closeStickyBtn = document.getElementById('close-sticky-bar');
      let stickyClosed = false;

      window.addEventListener('scroll', () => {
        const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
        if (totalHeight > 0 && progressBar) {
          const progress = (window.scrollY / totalHeight) * 100;
          progressBar.style.width = `${progress}%`;
        }

        // Back to top visibility
        if (backToTopBtn) {
          if (window.scrollY > 300) {
            backToTopBtn.classList.remove('opacity-0', 'pointer-events-none');
            backToTopBtn.classList.add('opacity-100');
          } else {
            backToTopBtn.classList.remove('opacity-100');
            backToTopBtn.classList.add('opacity-0', 'pointer-events-none');
          }
        }

        // Sticky conversion bar visibility
        if (stickyBar && !stickyClosed) {
          if (window.scrollY > 400) {
            stickyBar.classList.remove('translate-y-full');
          } else {
            stickyBar.classList.add('translate-y-full');
          }
        }
      });

      // Back to top click
      if (backToTopBtn) {
        backToTopBtn.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }

      // Close sticky bar
      if (closeStickyBtn && stickyBar) {
        closeStickyBtn.addEventListener('click', () => {
          stickyClosed = true;
          stickyBar.classList.add('translate-y-full');
        });
      }

      // 2. Global Toast Notification for Copy
      const toast = document.getElementById('toast-container');
      const toastMsg = document.getElementById('toast-message');
      let toastTimer: any = null;

      function showToast(msg: string) {
        if (!toast || !toastMsg) return;
        toastMsg.textContent = msg;
        toast.classList.remove('opacity-0', '-translate-y-4');
        toast.classList.add('opacity-100', 'translate-y-0');

        if (toastTimer) clearTimeout(toastTimer);
        toastTimer = setTimeout(() => {
          toast.classList.remove('opacity-100', 'translate-y-0');
          toast.classList.add('opacity-0', '-translate-y-4');
        }, 2500);
      }

      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const copyBtn = target.closest('[data-copy-code]') as HTMLElement;
        if (copyBtn) {
          const code = copyBtn.getAttribute('data-copy-code');
          if (code) {
            navigator.clipboard.writeText(code).then(() => {
              showToast(`优惠码 [${code}] 已成功复制！前往官网结账时粘贴即可立减`);
            }).catch(() => {
              showToast(`优惠码：${code}`);
            });
          }
        }
      });
    </script>
  </body>
</html>
