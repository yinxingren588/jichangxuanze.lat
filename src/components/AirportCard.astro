---
import type { Airport } from '../data/airports';

interface Props {
  airport: Airport;
  isFullRow?: boolean;
}

const { airport, isFullRow = false } = Astro.props;
---

<div
  class={`airport-card group relative rounded-2xl transition-all duration-300 flex flex-col justify-between ${
    isFullRow
      ? 'md:col-span-2 p-6 sm:p-8 bg-gradient-to-br from-slate-900 via-slate-900/95 to-cyan-950/40 border-2 border-cyan-500/70 shadow-2xl shadow-cyan-950/60 hover:border-cyan-400 hover:shadow-cyan-900/80'
      : 'p-6 bg-slate-900/90 border border-slate-800 hover:border-cyan-500/50 hover:shadow-xl hover:shadow-cyan-950/40'
  }`}
  data-category={airport.category}
>
  {isFullRow && (
    <div class="absolute -top-12 -right-12 w-48 h-48 bg-cyan-500/10 blur-3xl rounded-full pointer-events-none"></div>
  )}

  <!-- Top Banner / Badge -->
  <div>
    <div class="flex items-center justify-between gap-2 mb-3">
      <div class="flex items-center gap-2">
        <span class={`inline-flex items-center justify-center rounded-lg font-bold text-xs ${
          isFullRow
            ? 'w-8 h-8 bg-cyan-500 text-slate-950 shadow-md shadow-cyan-500/30 text-sm'
            : 'w-7 h-7 bg-cyan-950 border border-cyan-800/80 text-cyan-400'
        }`}>
          #{airport.rank}
        </span>
        <span class={`text-xs font-semibold px-2.5 py-1 rounded-full ${
          isFullRow
            ? 'bg-cyan-950 text-cyan-300 border border-cyan-800/80'
            : 'bg-slate-800 text-slate-300 border border-slate-700/60'
        }`}>
          {airport.categoryLabel}
        </span>
      </div>

      {isFullRow ? (
        <span class="text-xs font-bold px-3 py-1 rounded-full bg-gradient-to-r from-amber-500/25 via-amber-400/20 to-orange-500/25 text-amber-300 border border-amber-400/40 shadow-sm animate-pulse">
          ★ 👑 站长力荐 · 全网综合 TOP 1 镇站专线
        </span>
      ) : airport.badge ? (
        <span class="text-xs font-medium px-2.5 py-0.5 rounded-full bg-gradient-to-r from-amber-500/20 to-orange-500/20 text-amber-300 border border-amber-500/30">
          ★ {airport.badge}
        </span>
      ) : null}
    </div>

    <!-- Title & Slogan -->
    <div class="mb-4">
      <div class="flex items-start justify-between gap-4">
        <div class="flex items-start sm:items-center gap-3.5">
          {airport.logo && (
            <img
              src={airport.logo}
              alt={`${airport.name} Logo`}
              class={`${
                isFullRow
                  ? 'w-14 h-14 sm:w-16 sm:h-16 rounded-2xl border-2 border-cyan-500/60 shadow-lg shadow-cyan-950/50'
                  : 'w-11 h-11 rounded-xl border border-slate-700 shadow-md'
              } bg-white p-1 object-contain shrink-0`}
            />
          )}
          <div>
            <h3 class={`${isFullRow ? 'text-2xl sm:text-3xl' : 'text-xl'} font-extrabold text-white group-hover:text-cyan-400 transition-colors`}>
              <a href={`/reviews/${airport.reviewSlug || airport.slug}`}>
                {airport.name}
              </a>
            </h3>
            <p class={`${isFullRow ? 'text-sm text-slate-300' : 'text-xs text-slate-400'} mt-1.5 leading-relaxed`}>
              {airport.slogan}
            </p>
          </div>
        </div>
        <div class="text-right shrink-0">
          <span class="text-xs text-slate-400">起步</span>
          <span class={`${isFullRow ? 'text-3xl sm:text-4xl' : 'text-2xl'} font-extrabold text-cyan-400 ml-1`}>
            ¥{airport.priceStart}
          </span>
          <span class="text-xs text-slate-400">/{airport.billingCycle}</span>
          {airport.slug === 'invisible' && (
            <span class="block text-[11px] text-emerald-400 font-medium">年付折合约 ¥8/月</span>
          )}
        </div>
      </div>
    </div>

    <!-- Key Metrics Grid: 4 columns when isFullRow on desktop! -->
    <div class={`grid gap-2 text-xs mb-4 ${
      isFullRow
        ? 'grid-cols-2 sm:grid-cols-4 p-4 rounded-xl bg-slate-950/80 border border-cyan-900/40'
        : 'grid-cols-2 p-3 rounded-xl bg-slate-950/60 border border-slate-800/60'
    }`}>
      <div>
        <span class="text-slate-500 block text-[11px]">线路类型</span>
        <span class={`font-medium ${isFullRow ? 'text-cyan-300 font-semibold' : 'text-slate-200'}`}>
          {airport.lineType}
        </span>
      </div>
      <div>
        <span class="text-slate-500 block text-[11px]">晚高峰实测</span>
        <span class="font-bold text-emerald-400 text-sm">{airport.speedPeak}</span>
      </div>
      <div>
        <span class="text-slate-500 block text-[11px]">入口调度</span>
        <span class="font-medium text-slate-200">{airport.bgp}</span>
      </div>
      <div>
        <span class="text-slate-500 block text-[11px]">流量套餐</span>
        <span class="font-medium text-slate-200">{airport.trafficOptions}</span>
      </div>
    </div>

    <!-- Unlock Tags -->
    <div class="mb-4">
      <div class="text-[11px] font-medium text-slate-400 mb-1.5 flex items-center gap-1">
        <span>🔓 解锁支持：</span>
      </div>
      <div class="flex flex-wrap gap-1.5">
        {airport.streamingUnlock.map((tag) => (
          <span class="text-[11px] px-2 py-0.5 rounded bg-slate-800/80 text-cyan-300 border border-slate-700/60">
            {tag}
          </span>
        ))}
      </div>
    </div>

    <!-- Highlight Pros -->
    <div class={`mb-5 ${isFullRow ? 'grid grid-cols-1 sm:grid-cols-2 gap-2' : 'space-y-1'}`}>
      {airport.pros.map((pro) => (
        <div class="flex items-start gap-1.5 text-xs text-slate-300">
          <span class="text-emerald-400 font-bold shrink-0">✓</span>
          <span>{pro}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- Bottom Actions & Coupon -->
  <div class={`pt-4 border-t border-slate-800/80 ${isFullRow ? 'space-y-4' : 'space-y-3'}`}>
    {airport.coupon && (
      <div class={`flex items-center justify-between p-2.5 rounded-xl border text-xs ${
        isFullRow
          ? 'bg-cyan-950/50 border-cyan-700/60'
          : 'bg-cyan-950/30 border border-cyan-800/40'
      }`}>
        <div class="flex items-center gap-1.5 text-cyan-300 truncate">
          <span class="text-base">🏷️</span>
          <span class="font-mono font-bold text-white text-sm tracking-wider">{airport.coupon.code}</span>
          <span class="text-[11px] text-cyan-400">({airport.coupon.discount})</span>
        </div>
        <button
          type="button"
          data-copy-code={airport.coupon.code}
          class={`shrink-0 px-3 py-1.5 text-xs font-semibold rounded-lg transition-all cursor-pointer ${
            isFullRow
              ? 'bg-cyan-500 hover:bg-cyan-400 text-slate-950 shadow-md shadow-cyan-500/25'
              : 'bg-cyan-900/60 hover:bg-cyan-800 text-cyan-200'
          }`}
        >
          一键复制折扣码
        </button>
      </div>
    )}

    <div class="grid grid-cols-2 gap-2.5">
      <a
        href={`/reviews/${airport.reviewSlug || airport.slug}`}
        class={`py-2.5 px-3 rounded-xl text-center text-xs font-medium transition-colors ${
          isFullRow
            ? 'bg-slate-800/90 text-slate-200 hover:bg-slate-700 hover:text-white border border-slate-700/60'
            : 'bg-slate-800 text-slate-300 hover:bg-slate-700 hover:text-white'
        }`}
      >
        📖 查看深度测评报告
      </a>
      <a
        href={airport.affUrl}
        target="_blank"
        rel="noopener noreferrer nofollow"
        class={`py-2.5 px-3 rounded-xl text-center text-xs font-bold transition-all flex items-center justify-center gap-1.5 ${
          isFullRow
            ? 'bg-gradient-to-r from-cyan-400 via-teal-400 to-blue-500 text-slate-950 hover:brightness-110 shadow-lg shadow-cyan-500/30 text-sm'
            : 'bg-gradient-to-r from-cyan-500 to-blue-600 text-white hover:from-cyan-400 hover:to-blue-500 shadow-md shadow-cyan-500/20'
        }`}
      >
        <span>直达【{airport.name.split(' ')[0]}】官网选购</span>
        <span class="text-xs">↗</span>
      </a>
    </div>
  </div>
</div>
